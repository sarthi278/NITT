# Local Docker Compose PostgreSQL defaults.
# Replace these with values from your hosted PostgreSQL provider for deployment.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=order_audit
DATABASE_USER=order_audit
DATABASE_PASSWORD=local-dev-password

# Leave empty for local PostgreSQL. Hosted providers may require "require".
DATABASE_SSLMODE=

DJANGO_SECRET_KEY=local-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
