{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PostgreSQL: Start Docker Compose",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\scripts\\start-postgres.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "postgres-startup",
          "pattern": {
            "regexp": "^$",
            "message": 0
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^\\[postgres\\] STARTING.*",
            "endsPattern": "^\\[postgres\\] (READY|SKIPPED).*"
          }
        }
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Django: Start UI and Backend",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\scripts\\start-django.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "django-startup",
          "pattern": {
            "regexp": "^$",
            "message": 0
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^\\[django\\] STARTING.*",
            "endsPattern": "^\\[django\\] (READY|ALREADY RUNNING).*|^Starting development server at http://.*"
          }
        }
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Build: Start complete application (Ctrl+Shift+B)",
      "dependsOn": [
        "PostgreSQL: Start Docker Compose",
        "Django: Start UI and Backend"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
